# 数据库连接信息
DATABASE_URL=postgresql://user:password@host:port/dbname

# AI 配置
# 可选: anthropic / deepseek / zhipu / minimax / kimi / doubao / openrouter / nvidia / aliyun / siliconflow / custom
AI_PROVIDER=deepseek

# 通用：覆盖 provider 默认模型（可选，不填则用各 provider 的默认模型）
# AI_MODEL=deepseek-chat

# ─── Anthropic (Claude) ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── DeepSeek ───
DEEPSEEK_API_KEY=sk-...

# ─── 智谱 (GLM) ───
ZHIPU_API_KEY=

# ─── MiniMax ───
MINIMAX_API_KEY=

# ─── Kimi (Moonshot) ───
KIMI_API_KEY=

# ─── 豆包 (Doubao / 字节) ───
DOUBAO_API_KEY=

# ─── OpenRouter ───
OPENROUTER_API_KEY=

# ─── NVIDIA NIM ───
NVIDIA_API_KEY=

# ─── 阿里云百炼 (DashScope) ───
ALIYUN_API_KEY=

# ─── 硅基流动 (SiliconFlow) ───
SILICONFLOW_API_KEY=

# ─── 自定义 (任意 OpenAI 兼容 API) ───
CUSTOM_AI_BASE_URL=https://your-api-endpoint/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=gpt-4o-mini

# ─── 文章抓取服务 ───
# 用于从微信公众号等来源抓取文章内容
READER_API_BASE=

# ─── 网页采集 / SingleFile ───
# Docker Compose 默认会启动 singlefile sidecar，通常不需要修改。
# 如果使用外部 SingleFile HTTP 服务，可改成对应地址。
SINGLEFILE_SERVICE_URL=http://singlefile:3000
SINGLEFILE_TIMEOUT_MS=180000
SINGLEFILE_MAX_BUFFER=83886080
# sidecar 失败后是否继续尝试 API 容器内的本地 single-file/docker/npx 兜底。
# 服务器 Docker 部署建议保持默认 true 或按需设为 false。
# SINGLEFILE_SERVICE_FALLBACK_LOCAL=false

# ─── 图片上传服务 ───
# 用于上传文章中的图片到图床（避免图片链接失效）
IMG_HOST=
IMG_API_KEY=
