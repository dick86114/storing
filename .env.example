# 数据库连接信息
DATABASE_URL=postgresql://user:password@host:port/dbname

# AI 配置
# 可选: anthropic / deepseek / zhipu / minimax / kimi / doubao / openrouter / nvidia / aliyun / siliconflow / custom
AI_PROVIDER=deepseek

# 通用：覆盖 provider 默认模型（可选，不填则用各 provider 的默认模型）
# AI_MODEL=deepseek-chat

# ─── Anthropic (Claude) ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── DeepSeek ───
DEEPSEEK_API_KEY=sk-...

# ─── 智谱 (GLM) ───
ZHIPU_API_KEY=

# ─── MiniMax ───
MINIMAX_API_KEY=

# ─── Kimi (Moonshot) ───
KIMI_API_KEY=

# ─── 豆包 (Doubao / 字节) ───
DOUBAO_API_KEY=

# ─── OpenRouter ───
OPENROUTER_API_KEY=

# ─── NVIDIA NIM ───
NVIDIA_API_KEY=

# ─── 阿里云百炼 (DashScope) ───
ALIYUN_API_KEY=

# ─── 硅基流动 (SiliconFlow) ───
SILICONFLOW_API_KEY=

# ─── 自定义 (任意 OpenAI 兼容 API) ───
CUSTOM_AI_BASE_URL=https://your-api-endpoint/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=gpt-4o-mini

# ─── 文章抓取服务 ───
# 用于从微信公众号等来源抓取文章内容
READER_API_BASE=

# ─── 图片上传服务 ───
# 用于上传文章中的图片到图床（避免图片链接失效）
IMG_HOST=
IMG_API_KEY=
