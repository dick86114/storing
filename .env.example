# 数据库连接信息
DATABASE_URL=postgresql://user:password@host:port/dbname

# 身份认证（生产环境必须设置为稳定且长期不变的随机值；不要在每次部署时更换）
JWT_SECRET=replace-with-a-long-stable-random-secret

# AI 配置
# 可选: anthropic / deepseek / zhipu / minimax / kimi / doubao / openrouter / nvidia / aliyun / siliconflow / custom
AI_PROVIDER=deepseek

# 通用：覆盖 provider 默认模型（可选，不填则用各 provider 的默认模型）
# AI_MODEL=deepseek-chat

# ─── Anthropic (Claude) ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── DeepSeek ───
DEEPSEEK_API_KEY=sk-...

# ─── 智谱 (GLM) ───
ZHIPU_API_KEY=

# ─── MiniMax ───
MINIMAX_API_KEY=

# ─── Kimi (Moonshot) ───
KIMI_API_KEY=

# ─── 豆包 (Doubao / 字节) ───
DOUBAO_API_KEY=

# ─── OpenRouter ───
OPENROUTER_API_KEY=

# ─── NVIDIA NIM ───
NVIDIA_API_KEY=

# ─── 阿里云百炼 (DashScope) ───
ALIYUN_API_KEY=

# ─── 硅基流动 (SiliconFlow) ───
SILICONFLOW_API_KEY=

# ─── 自定义 (任意 OpenAI 兼容 API) ───
CUSTOM_AI_BASE_URL=https://your-api-endpoint/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=gpt-4o-mini

# ─── 文章抓取服务 ───
# 用于从微信公众号等来源抓取文章内容
READER_API_BASE=

# ─── 网页采集 / SingleFile ───
# Docker Compose 默认会启动 singlefile sidecar，通常不需要修改。
# 如果使用外部 SingleFile HTTP 服务，可改成对应地址。
SINGLEFILE_SERVICE_URL=http://singlefile:3000
SINGLEFILE_TIMEOUT_MS=180000
SINGLEFILE_MAX_BUFFER=83886080
# sidecar 失败后是否继续尝试 API 容器内的本地 single-file/docker/npx 兜底。
# 服务器 Docker 部署建议保持默认 true 或按需设为 false。
# SINGLEFILE_SERVICE_FALLBACK_LOCAL=false

# ─── 图片上传服务 ───
# 用于上传文章中的图片到图床（避免图片链接失效）
IMG_HOST=
IMG_API_KEY=

# ─── Remote MCP / Streamable HTTP ───
# 独立 Streamable HTTP 服务监听端口。反向代理建议将公网 /mcp 转发到此端口。
MCP_HTTP_PORT=1053
# 远程 MCP 服务访问内部 Storing API 的地址；同机部署通常使用 localhost。
STORING_API_BASE=http://localhost:1052/api/v1
# 可选：逗号分隔的浏览器 Origin 白名单。服务端 SaaS 调用通常不携带 Origin。
MCP_ALLOWED_ORIGINS=https://your-storing-domain.example
# 前端生成的远程 MCP URL；生产环境应设置为反向代理后的 HTTPS 地址。
NEXT_PUBLIC_MCP_REMOTE_URL=https://your-storing-domain.example/mcp

# ─── 自助 MCP 基础配额（普通用户不可自行修改） ───
SELF_SERVICE_MCP_RATE_LIMIT_PER_MINUTE=20
SELF_SERVICE_MCP_RATE_LIMIT_PER_DAY=500
SELF_SERVICE_MCP_CONCURRENT_COLLECT_LIMIT=3

# ─── Web 采集队列 / 容错 ───
# 浏览器提交的采集任务默认串行执行，避免多个 Chromium/AI 任务耗尽 API 容器资源。
WEB_COLLECT_CONCURRENCY=1
# 服务重启后，超过该时间仍处于 running 的网页采集任务会恢复为 queued（毫秒）。
WEB_COLLECT_STALE_MS=300000
