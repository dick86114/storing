{
  "name": "storing",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "android:lint": "cd apps/android && ./gradlew lint",
    "android:test": "cd apps/android && ./gradlew testDebugUnitTest",
    "android:assembleDebug": "cd apps/android && ./gradlew assembleDebug",
    "android:assembleRelease": "cd apps/android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "undici": "7.28.0",
      "sharp": "0.35.3",
      "@hono/node-server": "2.0.11",
      "postcss": "8.5.10",
      "brace-expansion": "1.1.16",
      "js-yaml": "4.3.0",
      "esbuild": "0.28.1"
    }
  }
}
